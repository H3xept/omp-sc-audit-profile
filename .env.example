# Copy to .env in the installed profile directory and fill in your own keys.
# install.sh does this for you on first run. Never commit the filled-in file.

# Routes every model role in config.yml except the anthropic/ and openai-codex/ ones.
OPENROUTER_API_KEY=

# First entry in providers.webSearchOrder. Omit to fall back to the next provider.
EXA_API_KEY=

# Used by the recon and audit skills for verified-source and ABI lookups.
ETHERSCAN_API_KEY=
